# Copy this file to .env before starting the lab.
# These are local-lab credentials only. Do not reuse a real password.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=devshield-local-demo-only
JENKINS_HTTP_PORT=8080
# DevShield's own repository, which supplies the pipeline scripts.
DEVSHIELD_TOOL_GIT_URL=https://github.com/AslamJabri/devsecops-ai.git
DEVSHIELD_TOOL_GIT_BRANCH=main
# Choose the target repository in Jenkins using Build with Parameters.
