# Copy this file to .env before starting the lab.
# These are local-lab credentials only. Do not reuse a real password.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=devshield-local-demo-only
JENKINS_HTTP_PORT=8080
DEMO_APP_PORT=5001
# DevShield's own repository, which supplies the pipeline scripts.
DEVSHIELD_TOOL_GIT_URL=https://github.com/AslamJabri/devsecops-ai.git
DEVSHIELD_TOOL_GIT_BRANCH=main
# Set these only for a repository you own or are expressly authorized to assess.
DEVSHIELD_TARGET_GIT_URL=
DEVSHIELD_TARGET_GIT_BRANCH=main
# Optional: Jenkins credential ID for a private target repository (never put a token here).
DEVSHIELD_TARGET_GIT_CREDENTIALS_ID=
# Required safeguard. Set exactly to I_HAVE_PERMISSION before building the job.
DEVSHIELD_AUTHORIZATION_ACK=NO
